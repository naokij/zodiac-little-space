---
import Base from '~/layouts/Base.astro';
import ResponsiveImage from '~/components/ResponsiveImage.astro';
import { episodes, onlineEpisodes } from '~/data/episodes';
import { assetUrl, assetSrcset } from '~/data/asset-url';

const online = onlineEpisodes.length;
const total = episodes.length;
const upcoming = total - online;

// 客户端分页:每页集数;无 JS 时降级为完整列表(分页条默认 hidden,由脚本启用)
const PAGE_SIZE = 6;
const pageCount = Math.ceil(episodes.length / PAGE_SIZE);
---
<Base title="故事列表 · 十二星座小太空" active="list">
  <section data-od-id="page-hero">
    <span class="eyebrow">所有剧集</span>
    <h1 style="margin-top: 8px; margin-bottom: 12px;">小太空里的故事</h1>
    <p class="text-muted" style="max-width: 60ch;">
      按顺序听 —— 每集刚好是睡前一个故事的长度。已上线 {online} 集，新的故事正在创作中。
    </p>
    <div class="row" style="margin-top: 16px;">
      <span class="chip">已上线 · {online} 集</span>
      {upcoming > 0 && <span class="chip">创作中 · {upcoming} 集</span>}
      <span class="chip">十二星座故事线</span>
    </div>
  </section>

  <section data-od-id="episode-list" style="margin-top: 40px;">
    <div class="stack" style="--stack-gap: 18px;">
      {episodes.map((ep, i) => {
        const isOnline = ep.status === 'online';
        const inPage = i % PAGE_SIZE; // 页内序号,用于入场动画延迟
        const delayClass = inPage > 0 ? ` fade-in-d${Math.min(inPage, 3)}` : '';
        return (
          <article class={`episode-card${isOnline ? '' : ' is-coming'} fade-in${delayClass}`} data-od-id={`episode-${ep.number}`} data-status={ep.status} data-page={Math.floor(i / PAGE_SIZE) + 1}>
            {isOnline ? (
              <>
                <div class="ep-cover">
                  <ResponsiveImage
                    src={ep.cover}
                    alt={ep.title + '封面'}
                    sizes="(max-width: 720px) 90vw, 360px"
                    widths={[400, 800, 1200]}
                  />
                </div>
                <div class="ep-body">
                  <div class="ep-num">EPISODE {String(ep.number).padStart(2, '0')}</div>
                  <h3>{ep.title}</h3>
                  <p class="ep-desc">
                    {ep.excerpt}
                  </p>
                  <div class="row" style="margin-bottom: 12px;">
                    <span class="chip">{ep.duration}</span>
                    <span class="chip">已上线</span>
                  </div>
                  <a class="btn btn-primary" href={`/story/${ep.slug}`} data-od-id={`open-episode-${ep.number}`}>
                    打开第 {ep.number} 集
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </>
            ) : (
              <>
                <div class="ep-cover">
                  <span class="coming-note">敬请期待</span>
                </div>
                <div class="ep-body">
                  <div class="ep-num">EPISODE {String(ep.number).padStart(2, '0')}</div>
                  <h3>{ep.title}</h3>
                  <button class="btn" disabled style="opacity: 0.55; margin-top: auto;">剧本待定 · 不开放收听</button>
                </div>
              </>
            )}
          </article>
        );
      })}
    </div>

    {pageCount > 1 && (
      <nav class="pagination" aria-label="剧集翻页" data-pages={pageCount} hidden>
        <button class="chip" type="button" data-nav="prev" aria-label="上一页">← 上一页</button>
        {Array.from({ length: pageCount }, (_, p) => (
          <button class={`chip${p === 0 ? ' is-active' : ''}`} type="button" data-page={p + 1} aria-current={p === 0 ? 'page' : undefined}>{p + 1}</button>
        ))}
        <button class="chip" type="button" data-nav="next" aria-label="下一页">下一页 →</button>
      </nav>
    )}
  </section>

  <!-- 分节符:剧集列表 → CTA -->
  <div class="flourish" aria-hidden="true">
    <img src={assetUrl('/assets/decor/星月分隔串-1600.webp')} srcset={assetSrcset('/assets/decor/星月分隔串-800.webp 800w, /assets/decor/星月分隔串-1600.webp 1600w')} sizes="(max-width: 720px) 70vw, 460px" alt="" loading="lazy" />
  </div>

  <section style="margin-top: 56px;" data-od-id="cta-back">
    <div class="card" style="padding: 28px; text-align: center;">
      <span class="eyebrow">还没听够?</span>
      <h2 style="margin-top: 8px; margin-bottom: 12px;">从第一集开始</h2>
      <p class="text-muted" style="max-width: 50ch; margin: 0 auto 20px;">
        每集都设计成睡前一个故事的长度 —— 听完刚好做个好梦。
      </p>
      <a class="btn btn-primary" href="/story/1-想家的大海">开始睡前听</a>
    </div>
  </section>

  <!-- 页尾装饰分隔符 · 撑满视口宽度 -->
  <div class="flourish" style="max-width: none; width: 100%; padding: 0 24px; box-sizing: border-box;" aria-hidden="true">
    <img src={assetUrl('/assets/decor/星月分隔串-1600.webp')} srcset={assetSrcset('/assets/decor/星月分隔串-800.webp 800w, /assets/decor/星月分隔串-1600.webp 1600w')} sizes="(max-width: 720px) 70vw, 460px" alt="" loading="lazy" />
  </div>

  <script>
    // 剧集列表客户端分页:卡片在 Astro 端全部渲染并带 data-page,
    // 脚本负责显隐 + 重放入场动画;无 JS 时分页条保持 hidden,显示完整列表
    const nav = document.querySelector('.pagination');
    const cards = Array.from(document.querySelectorAll('.episode-card'));
    const pageCount = nav ? Number((nav as HTMLElement).dataset.pages) : 1;
    if (nav && pageCount > 1) {
      const navEl = nav as HTMLElement;
      const listTop = document.querySelector('[data-od-id="episode-list"]') as HTMLElement;
      const prev = navEl.querySelector('[data-nav="prev"]') as HTMLButtonElement;
      const next = navEl.querySelector('[data-nav="next"]') as HTMLButtonElement;
      const pageBtns = Array.from(navEl.querySelectorAll('button[data-page]')) as HTMLButtonElement[];
      let current = 1;

      function show(page: number, scroll = false) {
        current = Math.min(Math.max(page, 1), pageCount);
        let visible = 0;
        for (const card of cards) {
          const el = card as HTMLElement;
          const on = Number(el.dataset.page) === current;
          el.hidden = !on;
          if (on) {
            // 重放 fade-in 入场动画,按页内顺序错开延迟
            el.classList.remove('fade-in');
            void el.offsetWidth;
            el.style.animationDelay = `${Math.min(visible, 3) * 0.08}s`;
            el.classList.add('fade-in');
            visible++;
          }
        }
        for (const b of pageBtns) {
          const active = Number(b.dataset.page) === current;
          b.classList.toggle('is-active', active);
          if (active) b.setAttribute('aria-current', 'page');
          else b.removeAttribute('aria-current');
        }
        prev.disabled = current === 1;
        next.disabled = current === pageCount;
        if (scroll) listTop.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      prev.addEventListener('click', () => show(current - 1, true));
      next.addEventListener('click', () => show(current + 1, true));
      for (const b of pageBtns) b.addEventListener('click', () => show(Number(b.dataset.page), true));

      navEl.hidden = false;
      show(1);
    }
  </script>
</Base>
