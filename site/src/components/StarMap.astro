---
// 真实星座星图:1825《尤拉尼亚之镜》版画做底,发光星点 + 连线叠加在版画印着的真实星位上
// 输入 constellations.ts 的一个条目 + 版画图片地址,输出内联 SVG;viewBox 宽 200、高 c.h
import type { Constellation } from '~/data/constellations';

interface Props {
  c: Constellation;
  imgSrc: string; // 版画图片 URL(带 hash)
  name: string;   // 星座中文名(alt 用)
}
const { c, imgSrc, name } = Astro.props;

const b = c.brightestIndex !== undefined ? c.stars[c.brightestIndex] : undefined;
---
<svg class="sky-map" viewBox={`0 0 200 ${c.h}`} role="img" aria-label={c.brightestName ? `${name}星图,标注${c.brightestName}` : `${name}星图`}>
  <image href={imgSrc} x="0" y="0" width="200" height={c.h} preserveAspectRatio="none" />
  {c.lines.map(([i, j]) => (
    <line
      x1={c.stars[i].x} y1={c.stars[i].y}
      x2={c.stars[j].x} y2={c.stars[j].y}
      stroke="oklch(62% 0.13 80 / 0.85)" stroke-width="0.7"
    />
  ))}
  {c.stars.map((s) => (
    <circle cx={s.x} cy={s.y} r={s.r} fill="oklch(84% 0.16 88)" stroke="oklch(48% 0.10 85 / 0.7)" stroke-width="0.35" />
  ))}
  {b && (
    <circle cx={b.x} cy={b.y} r={b.r + 2.2} fill="none" stroke="oklch(55% 0.15 60)" stroke-width="0.7" opacity="0.9" />
  )}
  {b && c.brightestName && (
    <text
      x={Math.min(Math.max(b.x, 22), 178)}
      y={b.y > c.h - 18 ? b.y - b.r - 5 : b.y + b.r + 9}
      text-anchor="middle"
      font-size="7.5"
      fill="oklch(42% 0.09 70)"
      stroke="oklch(96% 0.03 90 / 0.85)" stroke-width="1.6" paint-order="stroke"
    >{c.brightestName}</text>
  )}
</svg>
